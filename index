<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Integrada — Chamada do Passeio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --paper: #FBF6EC;
    --paper-line: #E4D9BE;
    --card: #FFFDF8;
    --margin-red: #C0392B;
    --ink: #263148;
    --ink-light: #45557a;
    --accent-vai: #3F7D4F;
    --accent-vai-bg: #E7F1E8;
    --accent-nao: #B5533C;
    --accent-nao-bg: #F6E9E3;
    --accent-pendente: #9B8F73;
    --pendente-bg: #F1ECDF;
    --text: #2C2A25;
    --text-muted: #7A7566;
    --font-display: 'Caveat', cursive;
    --font-body: 'Inter', sans-serif;
    --radius: 10px;
  }
  *{ box-sizing: border-box; }
  html,body{
    margin:0; padding:0;
    background: var(--paper);
    background-image:
      repeating-linear-gradient(180deg, transparent 0, transparent 37px, var(--paper-line) 38px);
    font-family: var(--font-body);
    color: var(--text);
    min-height: 100vh;
  }
  body{
    display:flex; justify-content:center;
    padding: 28px 16px 60px;
  }
  .sheet{
    width: 100%;
    max-width: 780px;
    position: relative;
    padding-left: 34px;
  }
  .sheet::before{
    content:"";
    position:absolute;
    left: 18px; top:-6px; bottom:-6px;
    width: 2px;
    background: var(--margin-red);
    opacity: .55;
  }
  header{
    padding: 6px 0 18px;
  }
  header .eyebrow{
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
    margin: 0 0 2px;
  }
  h1{
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1;
    margin: 0 0 4px;
    color: var(--ink);
    font-weight: 700;
  }
  header p.sub{
    margin: 0;
    color: var(--text-muted);
    font-size: 14.5px;
  }

  nav.tabs{
    display:flex;
    gap: 4px;
    margin: 22px 0 16px;
    border-bottom: 2px solid var(--paper-line);
  }
  nav.tabs button{
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    background: transparent;
    border: none;
    padding: 10px 16px;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 8px 8px 0 0;
    position: relative;
    top: 2px;
  }
  nav.tabs button.active{
    color: var(--ink);
    background: var(--card);
    border: 2px solid var(--paper-line);
    border-bottom: 2px solid var(--card);
  }

  .card{
    background: var(--card);
    border: 2px solid var(--paper-line);
    border-radius: var(--radius);
    padding: 22px;
  }
  .panel{ display:none; }
  .panel.active{ display:block; }

  .summary{
    display:flex; gap:10px; flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .pill{
    font-size: 13px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
    display:flex; align-items:center; gap:6px;
  }
  .pill .dot{ width:8px; height:8px; border-radius:50%; }
  .pill.vai{ background: var(--accent-vai-bg); color: var(--accent-vai); }
  .pill.vai .dot{ background: var(--accent-vai); }
  .pill.nao{ background: var(--accent-nao-bg); color: var(--accent-nao); }
  .pill.nao .dot{ background: var(--accent-nao); }
  .pill.pendente{ background: var(--pendente-bg); color: var(--accent-pendente); }
  .pill.pendente .dot{ background: var(--accent-pendente); }

  input[type="text"], textarea, select{
    font-family: var(--font-body);
    font-size: 14.5px;
    padding: 10px 12px;
    border: 2px solid var(--paper-line);
    border-radius: 8px;
    background: #fff;
    color: var(--text);
  }
  input[type="text"], textarea { width: 100%; }
  select { cursor: pointer; min-width: 160px; }
  
  .filters-row {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }
  .filters-row input { flex: 1; }

  .row-form{
    display:flex; gap:8px; margin-bottom: 10px;
  }
  .row-form input{ flex:1; }

  button.btn{
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13.5px;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    cursor: pointer;
    background: var(--ink);
    color: #fff;
    white-space: nowrap;
  }
  button.btn:hover{ background: var(--ink-light); }
  button.btn.secondary{
    background: transparent;
    color: var(--ink);
    border: 2px solid var(--paper-line);
  }

  .section-label{
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 700;
    color: var(--text-muted);
    margin: 22px 0 10px;
  }
  .section-label:first-child{ margin-top: 0; }

  ul.roll{ list-style:none; margin:0; padding:0; }
  ul.roll li{
    display:flex; align-items:center; gap:12px;
    padding: 12px 4px;
    border-bottom: 1.5px dashed var(--paper-line);
  }
  ul.roll li:last-child{ border-bottom:none; }
  .num{
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text-muted);
    width: 30px;
    flex-shrink:0;
  }
  .name{
    flex:1;
    font-weight: 600;
    font-size: 15px;
  }
  .tag-turma {
    font-size: 11px;
    background: var(--pendente-bg);
    color: var(--accent-pendente);
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
    margin-left: 8px;
  }
  .name.riscado{
    text-decoration: line-through;
    color: var(--text-muted);
    font-weight: 500;
  }
  .status-btns{ display:flex; gap:6px; flex-shrink:0; }
  .status-btns button{
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12.5px;
    border: 2px solid var(--paper-line);
    background: #fff;
    color: var(--text-muted);
    border-radius: 7px;
    padding: 7px 10px;
    cursor: pointer;
    display:flex; align-items:center; gap:5px;
  }
  .status-btns button.vai-btn.on{ background: var(--accent-vai-bg); border-color: var(--accent-vai); color: var(--accent-vai); }
  .status-btns button.nao-btn.on{ background: var(--accent-nao-bg); border-color: var(--accent-nao); color: var(--accent-nao); }
  .check-mark{ display:inline-block; opacity:0; transform: scale(.4); transition: all .18s ease; }
  .status-btns button.on .check-mark{ opacity:1; transform: scale(1); }

  .del-btn{ background: transparent; border: none; color: var(--text-muted); font-size: 18px; cursor: pointer; padding: 2px 8px; }
  .del-btn:hover{ color: var(--accent-nao); }
  .empty{ text-align:center; color: var(--text-muted); font-size: 14px; padding: 30px 10px; font-style: italic; }

  .results-grid{ display:grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .result-col{ border: 2px solid var(--paper-line); border-radius: 8px; overflow:hidden; }
  .result-col h3{ margin:0; font-family: var(--font-display); font-size: 24px; padding: 10px 14px 8px; display:flex; justify-content: space-between; align-items:baseline; }
  .result-col.vai h3{ background: var(--accent-vai-bg); color: var(--accent-vai); }
  .result-col.nao h3{ background: var(--accent-nao-bg); color: var(--accent-nao); }
  .result-col .count{ font-family: var(--font-body); font-size: 13px; font-weight:700; }
  .result-col ol{ margin:0; padding: 10px 14px 14px 30px; font-size: 14px; }
  .result-col li{ padding: 4px 0; }

  .pendentes-box{ margin-top: 18px; padding: 14px; background: var(--pendente-bg); border-radius: 8px; color: var(--accent-pendente); font-size: 13.5px; }
  .pendentes-box b{ color: var(--text); }
  .toolbar-bottom{ display:flex; justify-content:flex-end; margin-top: 18px; gap: 10px; }

  .conn-status{ font-size: 12px; color: var(--text-muted); display:flex; align-items:center; gap:6px; margin-top: 14px; }
  .conn-status .dot{ width:7px; height:7px; border-radius:50%; background: var(--accent-vai); }
  .conn-status .dot.off{ background: var(--accent-nao); }

  @media (max-width: 560px){
    .sheet{ padding-left: 24px; }
    h1{ font-size: 38px; }
    .results-grid{ grid-template-columns: 1fr; }
    .row-form, .filters-row{ flex-direction: column; }
    ul.roll li{ flex-wrap: wrap; }
    .status-btns{ margin-left: 42px; }
  }
</style>
</head>
<body>

