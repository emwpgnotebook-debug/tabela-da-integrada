<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>
<script>
  const firebaseConfig = {
    apiKey: "AIzaSyBXGCf4lPt5vf4s5VrWvSeNV8ZnKluGu0s",
    authDomain: "integrada-e58d4.firebaseapp.com",
    projectId: "integrada-e58d4",
    storageBucket: "integrada-e58d4.firebasestorage.app",
    messagingSenderId: "510299781804",
    appId: "1:510299781804:web:12cd43b722895f83a13d09",
    measurementId: "G-GGSBB13QPG"
  };
  firebase.initializeApp(firebaseConfig);
  const db = firebase.firestore();

  const alunosCol = db.collection('alunos');
  const confirmacoesCol = db.collection('confirmacoes');

  let alunos = [];        
  let confirmacoes = {};  

  const connDot = document.getElementById('conn-dot');
  const connText = document.getElementById('conn-text');
  window.addEventListener('online', () => setConn(true));
  window.addEventListener('offline', () => setConn(false));
  function setConn(ok){
    connDot.classList.toggle('off', !ok);
    connText.textContent = ok ? 'Conectado — mudanças salvas automaticamente' : 'Sem conexão — verifique sua internet';
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
    });
  });

  // CORREÇÃO DE SEGURANÇA: Ordenamos apenas por nome localmente para evitar a necessidade imediata de Índices Compostos complexos que bloqueiam o Firestore
  alunosCol.orderBy('nome').onSnapshot(snap => {
    alunos = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    setConn(true);
    renderAll();
  }, err => {
    console.error(err);
    connText.textContent = 'Erro ao carregar alunos. Verifique as Regras.';
  });

  confirmacoesCol.onSnapshot(snap => {
    confirmacoes = {};
    snap.docs.forEach(d => { confirmacoes[d.id] = d.data(); });
    renderAll();
  }, err => {
    console.error(err);
  });

  function renderAll(){
    renderChamada();
    renderCadastro();
    renderResultado();
  }

  // ---------- CHAMADA COM FILTRO DE TURMA ----------
  const listaChamada = document.getElementById('lista-chamada');
  const emptyChamada = document.getElementById('empty-chamada');
  const summaryBar = document.getElementById('summary-bar');
  const searchChamada = document.getElementById('search-chamada');
  const filterTurmaChamada = document.getElementById('filter-turma-chamada');

  searchChamada.addEventListener('input', renderChamada);
  filterTurmaChamada.addEventListener('change', renderChamada);

  function renderChamada(){
    const termo = searchChamada.value.trim().toLowerCase();
    const turmaSelecionada = filterTurmaChamada.value;

    const filtrados = alunos.filter(a => {
      const matchTurma = (turmaSelecionada === 'todas' || a.turma === turmaSelecionada);
      const matchNome = (a.nome || '').toLowerCase().includes(termo);
      return matchTurma && matchNome;
    });

    let vaiCount = 0, naoCount = 0;
    alunos.filter(a => turmaSelecionada === 'todas' || a.turma === turmaSelecionada).forEach(a => {
      const st = confirmacoes[a.id]?.status;
      if (st === 'vai') vaiCount++;
      else if (st === 'nao_vai') naoCount++;
    });
    const totalDestaTurma = alunos.filter(a => turmaSelecionada === 'todas' || a.turma === turmaSelecionada).length;
    const pendCount = totalDestaTurma - vaiCount - naoCount;

    summaryBar.innerHTML = `
      <span class="pill vai"><span class="dot"></span>${vaiCount} vão</span>
      <span class="pill nao"><span class="dot"></span>${naoCount} não vão</span>
      <span class="pill pendente"><span class="dot"></span>${pendCount} pendente(s)</span>
    `;

    emptyChamada.style.display = filtrados.length === 0 ? 'block' : 'none';

    listaChamada.innerHTML = filtrados.map((a) => {
      const st = confirmacoes[a.id]?.status;
      // Garante uma numeração sequencial limpa filtrada por turma
      const numeroChamada = alunos.filter(item => item.turma === a.turma).indexOf(a) + 1; 
      return `
        <li>
          <span class="num">${String(numeroChamada > 0 ? numeroChamada : 1).padStart(2,'0')}</span>
          <span class="name ${st === 'nao_vai' ? 'riscado' : ''}">
            ${escapeHtml(a.nome)} <span class="tag-turma">${a.turma || 'Sem Turma'}</span>
          </span>
          <span class="status-btns">
            <button class="vai-btn ${st==='vai' ? 'on':''}" data-id="${a.id}" data-nome="${escapeAttr(a.nome)}" data-status="vai">
              <span class="check-mark">✓</span> Vai
            </button>
            <button class="nao-btn ${st==='nao_vai' ? 'on':''}" data-id="${a.id}" data-nome="${escapeAttr(a.nome)}" data-status="nao_vai">
              <span class="check-mark">✕</span> Não vai
            </button>
          </span>
        </li>
      `;
    }).join('');

    listaChamada.querySelectorAll('button[data-status]').forEach(btn => {
      btn.addEventListener('click', () => toggleStatus(btn.dataset.id, btn.dataset.nome, btn.dataset.status));
    });
  }

  function toggleStatus(alunoId, nome, status){
    if (!alunoId) return;
    const atual = confirmacoes[alunoId]?.status;
    if (atual === status){
      confirmacoesCol.doc(alunoId).delete().catch(console.error);
    } else {
      confirmacoesCol.doc(alunoId).set({
        nome: nome || '',
        status: status,
        timestamp: firebase.firestore.FieldValue.serverTimestamp()
      }).catch(console.error);
    }
  }

  // ---------- CADASTRO ----------
  const inputUnico = document.getElementById('input-nome-unico');
  const selectTurmaUnico = document.getElementById('select-turma-unico');
  const btnAddUnico = document.getElementById('btn-add-unico');
  
  const selectTurmaLote = document.getElementById('select-turma-lote');
  const inputLote = document.getElementById('input-nomes-lote');
  const btnAddLote = document.getElementById('btn-add-lote');
  
  const listaCadastro = document.getElementById('lista-cadastro');
  const emptyCadastro = document.getElementById('empty-cadastro');
  const totalAlunosEl = document.getElementById('total-alunos');
  const filterTurmaCadastro = document.getElementById('filter-turma-cadastro');

  btnAddUnico.addEventListener('click', addUnico);
  filterTurmaCadastro.addEventListener('change', renderCadastro);

  function addUnico(){
    const nome = inputUnico.value.trim();
    const turma = selectTurmaUnico.value;
    if (!nome) return;
    alunosCol.add({ nome, turma, createdAt: firebase.firestore.FieldValue.serverTimestamp() })
      .then(() => { inputUnico.value=''; inputUnico.focus(); })
      .catch(alert);
  }

  btnAddLote.addEventListener('click', async () => {
    const nomes = inputLote.value.split('\n').map(n => n.trim()).filter(Boolean);
    const turma = selectTurmaLote.value;
    if (nomes.length === 0) return;
    
    btnAddLote.disabled = true;
    btnAddLote.textContent = 'Adicionando...';

    try {
      const CHUNK_SIZE = 500;
      for (let i = 0; i < nomes.length; i += CHUNK_SIZE) {
        const chunk = nomes.slice(i, i + CHUNK_SIZE);
        const batch = db.batch();
        chunk.forEach(nome => {
          const ref = alunosCol.doc();
          batch.set(ref, { nome, turma, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
        });
        await batch.commit();
      }
      inputLote.value = '';
      alert('Lista adicionada com sucesso na turma ' + turma);
    } catch (error) {
      alert('Erro ao salvar lote.');
    } finally {
      btnAddLote.disabled = false;
      btnAddLote.textContent = 'Adicionar lista';
    }
  });

  function renderCadastro(){
    const turmaFiltrada = filterTurmaCadastro.value;
    const filtrados = alunos.filter(a => turmaFiltrada === 'todas' || a.turma === turmaFiltrada);
    
    totalAlunosEl.textContent = filtrados.length;
    emptyCadastro.style.display = filtrados.length === 0 ? 'block' : 'none';
    
    listaCadastro.innerHTML = filtrados.map((a, i) => `
      <li>
        <span class="num">${String(i+1).padStart(2,'0')}</span>
        <span class="name">${escapeHtml(a.nome)} <span class="tag-turma">${a.turma || 'Sem Turma'}</span></span>
        <button class="del-btn" data-id="${a.id}">×</button>
      </li>
    `).join('');

    listaCadastro.querySelectorAll('.del-btn').forEach(btn => {
      btn.addEventListener('click', () => removerAluno(btn.dataset.id));
    });
  }

  function removerAluno(id){
    if(confirm('Deseja mesmo remover este aluno?')){
      alunosCol.doc(id).delete().catch(console.error);
      confirmacoesCol.doc(id).delete().catch(()=>{});
    }
  }

  // ---------- RESULTADO FILTRADO ----------
  const filterTurmaResultado = document.getElementById('filter-turma-resultado');
  filterTurmaResultado.addEventListener('change', renderResultado);

  function renderResultado(){
    const turmaFiltrada = filterTurmaResultado.value;
    const vai = [], nao = [];
    
    const alunosFiltrados = alunos.filter(a => turmaFiltrada === 'todas' || a.turma === turmaFiltrada);
    
    alunosFiltrados.forEach(a => {
      const st = confirmacoes[a.id]?.status;
      const nomeExibicao =編 = turmaFiltrada === 'todas' ? `${a.nome} (${a.turma || 'S/T'})` : a.nome;
      if (st === 'vai') vai.push(nomeExibicao);
      else if (st === 'nao_vai') nao.push(nomeExibicao);
    });
    
    vai.sort(); nao.sort();
    const pend = alunosFiltrados.length - vai.length - nao.length;

    document.getElementById('count-vai').textContent = vai.length;
    document.getElementById('count-nao').textContent = nao.length;
    document.getElementById('lista-vai').innerHTML = vai.map(n => `<li>${escapeHtml(n)}</li>`).join('') || '<li style="list-style:none;color:var(--text-muted);">Ninguém ainda.</li>';
    document.getElementById('lista-nao').innerHTML = nao.map(n => `<li>${escapeHtml(n)}</li>`).join('') || '<li style="list-style:none;color:var(--text-muted);">Ninguém ainda.</li>';
    document.getElementById('pendentes-box').innerHTML = `<b>${pend}</b> aluno(s) ainda sem resposta nesta seleção.`;
  }

  document.getElementById('btn-export-csv').addEventListener('click', () => {
    const turmaFiltrada = filterTurmaResultado.value;
    const linhas = [['Nome', 'Turma', 'Status']];
    
    const alunosFiltrados = alunos.filter(a => turmaFiltrada === 'todas' || a.turma === turmaFiltrada);
    
    alunosFiltrados.forEach(a => {
      const st = confirmacoes[a.id]?.status;
      const label = st === 'vai' ? 'Vai' : st === 'nao_vai' ? 'Não vai' : 'Pendente';
      linhas.push([a.nome, a.turma || 'Não Definida', label]);
    });
    
    const csv = linhas.map(l => l.map(c => `"${c.replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `confirmacoes-${turmaFiltrada.replace(/\s/g, '_')}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  function escapeHtml(str){
    return String(str || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function escapeAttr(str){ return escapeHtml(str); }

  setConn(navigator.onLine);
</script>
</body>
</html>