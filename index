      <div class="filters-row" style="margin-top:20px;">
        <span class="section-label" style="margin:0; align-self:center;">Alunos Cadastrados (<span id="total-alunos">0</span>)</span>
        <select id="filter-turma-cadastro">
          <option value="todas">Ver Todas as Turmas</option>
          <optgroup label="TURNO DA MANHÃ">
