      <div class="row-form">
        <select id="select-turma-unico">
          <optgroup label="TURNO DA MANHÃ">
            <option value="1ºA">1ºA (Manhã)</option>
            <option value="1ºB">1ºB (Manhã)</option>
            <option value="2ºA">2ºA (Manhã)</option>
            <option value="2ºB">2ºB (Manhã)</option>
            <option value="3ºA">3ºA (Manhã)</option>
            <option value="3ºB">3ºB (Manhã)</option>
            <option value="4ºA">4ºA (Manhã)</option>
            <option value="4ºB">4ºB (Manhã)</option>
            <option value="6ºA">6ºA (Manhã)</option>
          </optgroup>
          <optgroup label="TURNO DA TARDE">
            <option value="5ºA">5ºA (Tarde)</option>
            <option value="5ºB">5ºB (Tarde)</option>
